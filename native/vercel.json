{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://getneville.vercel.app/api/:path*"
    },
    {
      "source": "/voice-samples/:path*",
      "destination": "https://getneville.vercel.app/voice-samples/:path*"
    },
    {
      "source": "/((?!_expo|assets|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "cleanUrls": true
}
