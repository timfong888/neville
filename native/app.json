{
  "expo": {
    "name": "Neville",
    "slug": "neville",
    "version": "2.0.0",
    "scheme": "neville",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151820",
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pckg.neville",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Neville uses the microphone only if you choose to record your own voice.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "usesAppleSignIn": true,
      "requireFullScreen": true
    },
    "extra": {
      "eas": {
        "projectId": "06736e9f-b30f-46e4-88a2-ac392ba047ec"
      }
    },
    "owner": "blockstitch"
  }
}
